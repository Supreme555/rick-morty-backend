generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Cache of AI-generated character descriptions (one per character).
model AiDescription {
  characterId Int      @id @map("character_id")
  description String
  model       String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("ai_descriptions")
}
