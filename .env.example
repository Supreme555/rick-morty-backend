DATABASE_URL="postgresql://postgres:password@127.0.0.1:5434/rick-morty-test?schema=public"

PORT=4009
NODE_ENV=development
FRONTEND_URL=http://localhost:4008

# SSH tunnel to the remote Postgres (dev only; skipped when NODE_ENV=production)
SSH_HOST=your-server-ip
SSH_PORT=22
SSH_USER=your-user
SSH_LOCAL_PORT=5434
SSH_DST_HOST=127.0.0.1
SSH_DST_PORT=5432
SSH_KEY_NAME=id_ed25519

# Upstream API (defaults to the public one)
# RICK_API_URL=https://rickandmortyapi.com/api

# Gemini (Google AI Studio) — AI character descriptions. Without a key new
# descriptions are not generated (/ai answers 503, the UI shows a note);
# already generated ones are still served from the DB cache.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash   (gemini-2.5-flash больше недоступна новым ключам)
# Thinking: gemini-2.5-flash* -> thinkingBudget 0, gemini-3* -> thinkingLevel MINIMAL.
# Override with one of:
# GEMINI_THINKING_LEVEL=MINIMAL        (MINIMAL|LOW|MEDIUM|HIGH, Gemini 3.x)
# GEMINI_THINKING_BUDGET=0         (tokens, 0 = off, -1 = auto, Gemini 2.5)
